# =============================================================================
# Project data
# =============================================================================
# Two exceptions are intentionally tracked below: the RADCURE Version 4
# clinical source workbook (distributed by TCIA under CC BY 4.0 -- see
# data/README.md for the full license and attribution) and the frozen
# derived modelling cohort it produces (data/processed/modeling_cohort.csv,
# generated by analysis/01, versioned as a reproducibility snapshot). Every
# other file under data/raw/, data/interim/ and data/processed/ stays
# ignored by default.

data/raw/*
data/interim/*
data/processed/*

!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

!data/raw/README.md
!data/interim/README.md
!data/processed/README.md

!data/raw/RADCURE_Clinical_v04_20241219.xlsx
!data/processed/modeling_cohort.csv


# =============================================================================
# Pipeline artefacts (analysis/01 -> analysis/07)
# =============================================================================
# The aggregated stage results are small, human-readable and worth versioning:
# they are the reproducible record of every number quoted in the README.
#
# Patient-level OOF and held-out prediction artefacts are not versioned.
# This is a repository-design choice: they are regenerable intermediate
# model outputs and are not needed for the compact public review surface.
# It is not a licensing restriction. The CC BY 4.0 raw clinical workbook
# and the frozen derived modelling cohort are intentionally versioned;
# see data/README.md.
artifacts/04_oof_scores.csv
artifacts/06_heldout_predictions.csv


# =============================================================================
# Trained models and serialized objects
# =============================================================================

models/*
!models/.gitkeep
!models/README.md

*.joblib
*.pkl
*.pickle


# =============================================================================
# Temporary files
# =============================================================================

*.tmp
*.temp
*.log
*~
.DS_Store
Thumbs.db


